generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  RUNNING
  COMPLETED
  PAUSED
  CANCELLED
}

enum EmailStatus {
  SCHEDULED
  QUEUED
  PROCESSING
  SENDING
  SENT
  FAILED
  RETRY_PENDING
}

enum DeliveryStatus {
  PENDING
  SUCCESS
  FAILED
}

model User {
  id              String           @id @default(cuid())
  googleId        String?          @unique
  email           String           @unique
  name            String?
  avatarUrl       String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  campaigns       Campaign[]
  senders         Sender[]
  slackConnection SlackConnection?
}

model Sender {
  id          String     @id @default(cuid())
  userId      String
  email       String
  displayName String?
  etherealUser String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaigns   Campaign[]
  emails      Email[]

  @@unique([userId, email])
  @@index([userId])
}

model Campaign {
  id                   String         @id @default(cuid())
  userId               String
  senderId             String
  subject              String
  body                 String
  startTime            DateTime
  delayBetweenEmailsMs Int            @default(2000)
  hourlyLimit          Int            @default(100)
  status               CampaignStatus @default(DRAFT)
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  user                User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  sender              Sender         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  emails              Email[]

  @@index([userId])
  @@index([senderId])
  @@index([status])
  @@index([startTime])
}

model Email {
  id              String      @id @default(cuid())
  campaignId      String
  senderId        String
  recipient       String
  subject         String
  body            String
  scheduledAt     DateTime
  sentAt          DateTime?
  status          EmailStatus @default(SCHEDULED)
  attemptCount    Int         @default(0)
  idempotencyKey  String      @unique
  bullJobId       String?     @unique
  messageId       String?
  lastError       String?
  sequence        Int
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  campaign        Campaign    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  sender          Sender      @relation(fields: [senderId], references: [id], onDelete: Cascade)
  deliveryAttempts DeliveryAttempt[]

  @@index([campaignId])
  @@index([senderId])
  @@index([recipient])
  @@index([status])
  @@index([scheduledAt])
  @@index([sentAt])
}

model DeliveryAttempt {
  id            String         @id @default(cuid())
  emailId       String
  attemptNumber Int
  status        DeliveryStatus
  providerId    String?
  errorMessage  String?
  attemptedAt   DateTime       @default(now())

  email         Email          @relation(fields: [emailId], references: [id], onDelete: Cascade)

  @@unique([emailId, attemptNumber])
  @@index([emailId])
}

model SlackConnection {
  id          String   @id @default(cuid())
  userId      String   @unique
  teamId      String
  teamName    String
  accessToken String
  channelId   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
